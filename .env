CARGO_PKG_VERSION=0.1.0

# Server Configuration
SERVER_HOST=127.0.0.1
WORKERS=4

# Security
ALLOWED_PATHS=
MAX_FILE_SIZE=10485760
MAX_PREVIEW_SIZE=1048576     # 1MB

ENABLE_CORS=true

# Features
ENABLE_FILE_WATCH=true
ENABLE_SEARCH=true
ENABLE_PREVIEW=true
MAX_PREVIEW_SIZE=1048576

# Logging
RUST_LOG=info,peek_backend=debug
LOG_FILE=logs/peek.log

# Cache
CACHE_DIR=./cache
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60


# Maximum file size for preview (default: 1MB)
MAX_PREVIEW_SIZE=1048576

# For larger previews (5MB)
MAX_PREVIEW_SIZE=5242880
